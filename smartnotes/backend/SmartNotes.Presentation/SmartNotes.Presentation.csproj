  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartNotes.Application\SmartNotes.Application.csproj" />
    <ProjectReference Include="..\SmartNotes.Infrastructure\SmartNotes.Infrastructure.csproj" />
  </ItemGroup>

</Project>